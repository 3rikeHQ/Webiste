# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/3rike

# JWT signing secret (required in production)
JWT_SECRET=change-me

# Optional: protect the cron endpoint
CRON_SECRET=change-me

# Paycrest Sender API (leave unset to run in mock mode)
# PAYCREST_API_KEY=
# PAYCREST_BASE_URL=https://api.paycrest.io
# PAYCREST_SENDER_ID=

# USDC deposit address shown to users (mock default is a placeholder)
# DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000
